# ==============================================================================
# Environment Configuration Template for Shared Table Ledger C++ Backend
# Copy this file to .env for local development or set these variables in Render
# ==============================================================================

# Server Network Configuration (Render sets PORT dynamically)
PORT=8080
HOST=0.0.0.0
APP_ENV=production
LOG_LEVEL=INFO
SERVER_THREADS=4

# PostgreSQL Database Configuration
# In Render: Automatically provided by Render PostgreSQL service
# Example: postgres://username:password@dpg-xxxxxx-a.oregon-postgres.render.com/mess_db?sslmode=require
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/mess_manager?sslmode=require

# Authentication & Security
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production!

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=https://shared-table-ledger.vercel.app,http://localhost:3000,http://localhost:5173

# Local Offline Storage (Used only in development when DATABASE_URL is unset)
DATA_PATH=./data/mess_store.json
